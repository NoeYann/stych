{
  "manifest_version": 3,
  "name": "Stych Suivi",
  "version": "0.6.2",
  "description": "Capture ton niveau de confiance avant chaque validation de question sur les examens blancs Stych, et consulte tes résultats corrigés.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stych Suivi"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/elearning/formation-test-code/*",
        "*://*/elearning/formation/*/evaluation*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["results.html", "results.js", "results.css"],
      "matches": ["https://*.stych.fr/*"]
    }
  ]
}
